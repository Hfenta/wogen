PORT=4000
NODE_ENV=development

# mock = built-in simulator, rafiki = Rafiki payout API
PAYOUT_PROVIDER=mock
MOCK_STEP_MS=2500
QUOTE_TTL_MINUTES=30

# Dev logins: token:userId pairs, comma separated
DEV_TOKENS=dev-token-hailey:user_hailey

# Rafiki (fill in after you get sandbox keys)
RAFIKI_BASE_URL=https://rest.sandbox.rafiki-api.com/v1
RAFIKI_API_KEY=
RAFIKI_WEBHOOK_SECRET=
